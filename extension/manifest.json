{
  "manifest_version": 3,
  "name": "AI Form Filler (Local Ollama)",
  "version": "1.2",
  "description": "Scans web forms on click and fills them from your local profile using Ollama. No API key or AI subscription required.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8731/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Form Filler",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
