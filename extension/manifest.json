{
  "manifest_version": 3,
  "name": "AI-Filler",
  "version": "2.0.0",
  "description": "Fill web forms from a structured candidate profile, with deterministic matching, Groq fallback, and resume-to-profile onboarding.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8731/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI-Filler",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  }
}
